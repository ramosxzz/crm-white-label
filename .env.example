# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API (Meta) - opcional, configurado por tenant via UI
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-random-string

# Instagram DM via Meta Messenger Platform
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=change-me-random-string

# Automacoes - chave para proteger endpoint de processamento
CRON_SECRET=change-me-random-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (opcional; recomendado para midias do chat em producao)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=solaire-chat-media

# Api4com - botao de ligar nos leads
API4COM_TOKEN=
