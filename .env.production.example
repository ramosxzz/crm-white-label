# Dominio usado pelo Caddy na VPS. Exemplo: crm.seudominio.com.br
APP_DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com

# URL publica do app. Precisa bater com o dominio acima quando virar producao.
NEXT_PUBLIC_APP_URL=https://crm.example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (armazenamento de midias do chat)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=solaire-chat-media

# Webhooks e automacoes
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-random-string
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=change-me-random-string
CRON_SECRET=change-me-random-cron-secret

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# Meta - WhatsApp Cloud API (Embedded Signup). NEXT_PUBLIC_* precisam estar
# aqui pois sao "assados" no build da imagem Docker (ver docker-compose.vps.yml
# build.args) - so terem valor no .env.production nao e suficiente.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=

# IA, se usada em automacoes
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Sentry (monitoramento de erro)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token
