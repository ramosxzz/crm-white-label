{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  @health path /api/health
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
  }
}
